//@version=6
indicator("ストキャスエイト", shorttitle="Sto8", overlay=false, max_labels_count=500)

// ===== パネル位置調整（上に入れる透明な空行の数）=====
topSpacer = 2

// ===== 入力 =====
grpP = "期間"
p1 = input.int(3,  "短期1", minval=1, group=grpP)
p2 = input.int(5,  "短期2", minval=1, group=grpP)
p3 = input.int(8,  "短期3", minval=1, group=grpP)
p4 = input.int(10, "短期4", minval=1, group=grpP)
p5 = input.int(30, "長期1", minval=1, group=grpP)
p6 = input.int(35, "長期2", minval=1, group=grpP)
p7 = input.int(40, "長期3", minval=1, group=grpP)
p8 = input.int(45, "長期4", minval=1, group=grpP)

grpL = "判定"
smoothK  = input.int(1, "%K平滑化", minval=1, group=grpL)
obLevel  = input.float(80, "買われすぎライン", group=grpL)
osLevel  = input.float(20, "売られすぎライン", group=grpL)
needCnt  = input.int(8, "全体判定に必要な本数", minval=1, maxval=8, group=grpL)
showSig  = input.bool(true, "シグナル表示", group=grpL)
showTbl  = input.bool(true, "パネル表示", group=grpL)

// ===== 計算 =====
f_sto(len) => ta.sma(ta.stoch(close, high, low, len), smoothK)

s1 = f_sto(p1)
s2 = f_sto(p2)
s3 = f_sto(p3)
s4 = f_sto(p4)
s5 = f_sto(p5)
s6 = f_sto(p6)
s7 = f_sto(p7)
s8 = f_sto(p8)

c1 = color.rgb(60, 120, 255)
c2 = color.rgb(40, 160, 255)
c3 = color.rgb(0, 200, 220)
c4 = color.rgb(0, 230, 200)
c5 = color.rgb(220, 60, 40)
c6 = color.rgb(255, 130, 30)
c7 = color.rgb(255, 170, 40)
c8 = color.rgb(220, 200, 60)

plot(s1, "短期1", c1)
plot(s2, "短期2", c2)
plot(s3, "短期3", c3)
plot(s4, "短期4", c4)
plot(s5, "長期1", c5)
plot(s6, "長期2", c6)
plot(s7, "長期3", c7)
plot(s8, "長期4", c8)

hline(obLevel, "買われすぎ", color.new(color.gray, 30), hline.style_dotted)
hline(50, "中央", color.new(color.gray, 60), hline.style_dotted)
hline(osLevel, "売られすぎ", color.new(color.gray, 30), hline.style_dotted)

// ===== 判定 =====
f_state(v) =>
    v >= obLevel ? "買われすぎ" : v <= osLevel ? "売られすぎ" : v >= 50 ? "強気圏" : "弱気圏"

obCnt = (s1 >= obLevel ? 1 : 0) + (s2 >= obLevel ? 1 : 0) + (s3 >= obLevel ? 1 : 0) + (s4 >= obLevel ? 1 : 0) + (s5 >= obLevel ? 1 : 0) + (s6 >= obLevel ? 1 : 0) + (s7 >= obLevel ? 1 : 0) + (s8 >= obLevel ? 1 : 0)
osCnt = (s1 <= osLevel ? 1 : 0) + (s2 <= osLevel ? 1 : 0) + (s3 <= osLevel ? 1 : 0) + (s4 <= osLevel ? 1 : 0) + (s5 <= osLevel ? 1 : 0) + (s6 <= osLevel ? 1 : 0) + (s7 <= osLevel ? 1 : 0) + (s8 <= osLevel ? 1 : 0)

allOB = obCnt >= needCnt
allOS = osCnt >= needCnt

avgV = (s1 + s2 + s3 + s4 + s5 + s6 + s7 + s8) / 8
totalTxt = avgV >= obLevel ? "買われすぎ状態" : avgV <= osLevel ? "売られすぎ状態" : avgV >= 50 ? "強気状態" : "弱気状態"
totalCol = avgV >= obLevel ? color.red : avgV <= osLevel ? color.lime : color.white

// ===== シグナル =====
sigOB = allOB and not allOB[1]
sigOS = allOS and not allOS[1]

var bool armedOB = false
var bool armedOS = false
if allOB
    armedOB := true
if allOS
    armedOS := true

longExit = armedOB and ta.crossunder(s1, obLevel)
shortExit = armedOS and ta.crossover(s1, osLevel)
if longExit
    armedOB := false
if shortExit
    armedOS := false

if showSig
    if sigOB
        label.new(bar_index, 100, "全体買われすぎ", style=label.style_label_down, color=color.new(color.red, 100), textcolor=color.red, size=size.small)
    if sigOS
        label.new(bar_index, 0, "全体売られすぎ", style=label.style_label_up, color=color.new(color.lime, 100), textcolor=color.lime, size=size.small)
    if longExit
        label.new(bar_index, s1, "ロング決済", style=label.style_label_down, color=color.new(color.fuchsia, 100), textcolor=color.fuchsia, size=size.small)
    if shortExit
        label.new(bar_index, s1, "ショート決済", style=label.style_label_up, color=color.new(color.aqua, 100), textcolor=color.aqua, size=size.small)

// ===== アラート（全体買われすぎ・全体売られすぎのみ）=====
alertcondition(sigOB, "全体買われすぎ", "全体買われすぎ")
alertcondition(sigOS, "全体売られすぎ", "全体売られすぎ")

// alert()：1本のアラートで2種類を通知
// freq_once_per_bar = 足の途中で条件を満たした最初のティックで即通知（足ごとに1回）
alertInfo = syminfo.ticker + " [" + timeframe.period + "] "
if sigOB
    alert(alertInfo + "全体買われすぎ", alert.freq_once_per_bar)
if sigOS
    alert(alertInfo + "全体売られすぎ", alert.freq_once_per_bar)

// ===== パネル =====
var table tbl = table.new(position.top_left, 1, topSpacer + 10, bgcolor=na, frame_width=0, border_width=0)
panelBg = color.new(color.black, 20)

f_row(r, name, len, v, col) =>
    table.cell(tbl, 0, r + topSpacer, name + "(期間" + str.tostring(len) + "): " + str.tostring(v, "0.00") + " - " + f_state(v), text_color=col, text_halign=text.align_left, text_size=size.small, bgcolor=panelBg)

if barstate.islast and showTbl
    for i = 0 to topSpacer - 1
        table.cell(tbl, 0, i, " ", text_size=size.small, bgcolor=na)
    table.cell(tbl, 0, topSpacer, "ストキャスエイト [" + timeframe.period + "]", text_color=color.white, text_halign=text.align_left, text_size=size.normal, bgcolor=panelBg)
    f_row(1, "短期1", p1, s1, c1)
    f_row(2, "短期2", p2, s2, c2)
    f_row(3, "短期3", p3, s3, c3)
    f_row(4, "短期4", p4, s4, c4)
    f_row(5, "長期1", p5, s5, c5)
    f_row(6, "長期2", p6, s6, c6)
    f_row(7, "長期3", p7, s7, c7)
    f_row(8, "長期4", p8, s8, c8)
    table.cell(tbl, 0, topSpacer + 9, "総合判定: " + totalTxt, text_color=totalCol, text_halign=text.align_left, text_size=size.small, bgcolor=panelBg)